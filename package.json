{
  "name": "orqent-openai-sdk",
  "version": "2.0.1",
  "description": "Agente local para Ollama usando exclusivamente el SDK oficial de OpenAI y Responses API function tools.",
  "type": "module",
  "private": true,
  "bin": {
    "orqent": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "check": "pnpm test"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.20.0 <12"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "openai": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "tsx": "4.23.5",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
